    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "dolibarr_product_ref",
        "work_library_ref",
        "reference",
        "label",
        "description",
        "product_link",
        "quantity",
        "unit",
        "unit_code",
        "status",
        "supplier",
        "pricing",
        "packaging",
        "selection_origin",
        "client_visible",
        "children"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "product",
            "service",
            "labor",
            "free",
            "subwork",
            "comment"
          ]
        },
        "dolibarr_product_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "work_library_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "reference": {
          "type": "string",
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        },
        "product_link": {
          "$ref": "#/$defs/webLink"
        },
        "quantity": {
          "$ref": "#/$defs/nullablePositiveNumber"
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "unit_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "supplier": {
          "$ref": "#/$defs/supplier"
        },
        "pricing": {
          "$ref": "#/$defs/componentPricing"
        },
        "packaging": {
          "$ref": "#/$defs/packaging"
        },
        "client_visible": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "selection_origin": {
          "$ref": "#/$defs/selectionOrigin"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "subwork"
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "children": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "comment"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "quantity": {
                "type": "null"
              },
              "unit": {
                "const": ""
              },
              "unit_code": {
                "type": "null"
              },
              "product_link": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "library_ref",
        "work_role",
        "reference",
        "label",
        "description",
        "quantity",
        "unit",
        "unit_code",
        "status",
        "calculation",
        "presentation",
        "components"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "library_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "work_role": {
          "enum": [
            "standard",
            "option",
            "information"
          ]
        },
        "reference": {
          "type": "string",
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        },
        "quantity": {
          "$ref": "#/$defs/nullablePositiveNumber"
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "unit_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "calculation": {
          "$ref": "#/$defs/workCalculation"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "components": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              },
              "work_role": {
                "not": {
                  "const": "information"
                }
              }
            },
            "required": [
              "status",
              "work_role"
            ]
          },
          "then": {
            "properties": {
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
