              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "affected_component_ids": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
